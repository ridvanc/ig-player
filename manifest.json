{
  "manifest_version": 3,
  "name": "IG Video Controls",
  "version": "1.0.0",
  "description": "Adds a seek bar, keyboard shortcuts, speed and volume controls to Instagram web videos and reels.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "IG Video Controls",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  }
}
